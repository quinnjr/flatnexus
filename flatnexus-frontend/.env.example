# Base URL of the FlatNexus backend. Must match FLATNEXUS_PUBLIC_URL on the
# server, since OAuth redirects and repository URLs are built from it.
PUBLIC_API_URL=http://localhost:4000

# Public origin this frontend is served from. Used for canonical URLs, JSON-LD
# @ids, the sitemap, and llms.txt — they must all agree, so this must be the
# origin users actually reach.
PUBLIC_SITE_URL=http://localhost:5173
