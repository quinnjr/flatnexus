# ---------------------------------------------------------------------------
# FlatNexus backend configuration
#
# Copy to `.env` and edit. Every value below is read by `src/config.rs`.
# ---------------------------------------------------------------------------

# HTTP
FLATNEXUS_PORT=4000
# Public base URL of this server. Used to build the `.flatpakrepo` / `.flatpakref`
# files that the flatpak CLI consumes, so it must be reachable by clients.
FLATNEXUS_PUBLIC_URL=http://localhost:4000

# Database
DATABASE_URL=postgres://flatnexus:flatnexus@localhost:5432/flatnexus

# Session tokens
# Generate with: openssl rand -hex 32
FLATNEXUS_JWT_SECRET=change-me-please-at-least-32-bytes-long
FLATNEXUS_SESSION_TTL_SECS=86400

# OSTree repository served at ${FLATNEXUS_PUBLIC_URL}/repo
FLATNEXUS_REPO_PATH=./data/repo
# Scratch space for staging repos and inbound bundles. Must be on the same
# filesystem as FLATNEXUS_REPO_PATH for cheap local pulls.
FLATNEXUS_STAGING_PATH=./data/staging

# Repository identity advertised to `flatpak remote-add`
FLATNEXUS_REPO_TITLE=FlatNexus
FLATNEXUS_REPO_DESCRIPTION=Community-hosted Flatpak distribution point
# Optional. When set, commits are signed and the public key is advertised in
# the .flatpakrepo file so clients verify signatures.
# FLATNEXUS_GPG_KEY_ID=ABCDEF0123456789
# Armored public key exported with: gpg --armor --export $KEY_ID > repo.gpg.asc
# FLATNEXUS_GPG_PUBLIC_KEY_PATH=./data/repo.gpg.asc

# ---------------------------------------------------------------------------
# Bundle archive — DigitalOcean Spaces (required)
#
# Uploaded .flatpak bundles are archived to a Spaces bucket, scoped by
# application id. This is separate from the OSTree repository above: the
# repository is what clients install from, the bucket is the archive of the
# original artifact each publisher uploaded.
#
# Credentials use the standard AWS variable names — a Spaces access key and
# secret go here, and every S3 tool you already have reads the same two.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

FLATNEXUS_SPACES_BUCKET=flatnexus-bundles
# Spaces datacenter. Sent as the S3 region.
FLATNEXUS_SPACES_REGION=nyc3
# Defaults to https://<region>.digitaloceanspaces.com. Override for MinIO:
#   FLATNEXUS_SPACES_ENDPOINT=http://localhost:9000
FLATNEXUS_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# Optional key prefix, so FlatNexus can share a bucket with something else.
# FLATNEXUS_SPACES_PREFIX=bundles
# Optional Spaces CDN origin. Only set this for a bucket whose objects are
# public — with it set, bundle links are unsigned CDN URLs instead of
# presigned ones.
# FLATNEXUS_SPACES_CDN_ENDPOINT=https://flatnexus-bundles.nyc3.cdn.digitaloceanspaces.com
# Lifetime of a presigned bundle download link.
FLATNEXUS_SPACES_PRESIGN_TTL_SECS=3600

# Uploads
# Hard ceiling on a single bundle upload, in bytes. Default 1 GiB.
#
# This is a memory-sizing decision as much as a quota: Armature buffers the
# whole request body before the handler runs, so roughly this much RAM is
# committed per concurrent upload. The archive upload to Spaces is streamed in
# 16 MiB parts and adds nothing that scales with bundle size, so this buffering
# is the only term that does. Raise it deliberately.
FLATNEXUS_MAX_BUNDLE_BYTES=1073741824

# OTP
# Validity window for emailed one-time codes, in seconds.
FLATNEXUS_EMAIL_OTP_TTL_SECS=600
FLATNEXUS_TOTP_ISSUER=FlatNexus

# SMTP (only required when publishers choose the EMAIL otp method)
FLATNEXUS_SMTP_HOST=localhost
FLATNEXUS_SMTP_PORT=1025
FLATNEXUS_SMTP_USERNAME=
FLATNEXUS_SMTP_PASSWORD=
FLATNEXUS_MAIL_FROM=no-reply@flatnexus.local

# CORS origin for the SvelteKit frontend. Also where the OAuth callback hands
# the browser back to, so it must be the origin the frontend is actually served
# from.
FLATNEXUS_CORS_ORIGIN=http://localhost:5173

# OAuth sign-in. Both providers are optional; one with no credentials set is
# simply not offered to the frontend.
#
# Register the callback URLs as:
#   ${FLATNEXUS_PUBLIC_URL}/auth/oauth/github/callback
#   ${FLATNEXUS_PUBLIC_URL}/auth/oauth/google/callback
# FLATNEXUS_GITHUB_CLIENT_ID=
# FLATNEXUS_GITHUB_CLIENT_SECRET=
# FLATNEXUS_GOOGLE_CLIENT_ID=
# FLATNEXUS_GOOGLE_CLIENT_SECRET=

# Postgres connection pool size. Bounds how many GraphQL resolvers can make
# progress concurrently.
FLATNEXUS_DB_MAX_CONNECTIONS=16
